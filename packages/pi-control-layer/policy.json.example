{
  "version": 1,
  "defaults": {
    "commands": {
      "banned": [
        {
          "id": "ban-rm-rf",
          "pattern": "rm -rf *",
          "reason": "Destructive recursive deletion",
          "enabled": true
        },
        {
          "id": "ban-sudo",
          "pattern": "sudo *",
          "reason": "Privilege escalation requires human execution",
          "enabled": true
        },
        {
          "id": "ban-chmod-777",
          "pattern": "*chmod*777*",
          "reason": "World-writable permissions",
          "enabled": true
        },
        {
          "id": "ban-fork-bomb",
          "pattern": ":(){ :|:& };:*",
          "reason": "Fork bomb",
          "enabled": true
        },
        {
          "id": "ban-curl-pipe-shell",
          "pattern": "curl *| *sh*, wget *| *sh*",
          "reason": "Remote code execution from network",
          "enabled": true
        }
      ],
      "approval": [
        {
          "id": "approve-git-push",
          "pattern": "git push*",
          "reason": "Publishing to remotes requires sign-off",
          "timeoutSeconds": 300,
          "enabled": true
        },
        {
          "id": "approve-npm-publish",
          "pattern": "npm publish*",
          "reason": "Public release requires sign-off",
          "timeoutSeconds": 300,
          "enabled": true
        },
        {
          "id": "approve-npm-install",
          "pattern": "npm install *, pip install *",
          "reason": "Supply-chain risk: new dependencies",
          "timeoutSeconds": 120,
          "enabled": true
        }
      ],
      "outputRedact": [
        {
          "id": "redact-secrets-output",
          "pattern": "cat *config*.yaml, cat .env, cat .env*, cat *credentials*, env, printenv, env | grep*, printenv | grep*, cat injected-test.txt"
        }
      ]
    },
    "files": {
      "blocked": [
        {
          "id": "block-env-files",
          "pattern": "**/.env*, **/credentials*, **/id_rsa*",
          "reason": "Credential material",
          "enabled": true
        },
        {
          "id": "block-ssh-dir",
          "pattern": "~/.ssh/**",
          "reason": "Private keys",
          "enabled": true
        },
        {
          "id": "block-git-internal",
          "pattern": "**/.git/**",
          "reason": "Git internals are not agent territory",
          "enabled": false
        }
      ],
      "redact": [
        {
          "id": "redact-secrets-in-config",
          "pattern": "**/*.env, **/config*.yaml, **/config*.yml, **/secrets*, **/config-test.yaml",
          "enabled": true,
          "redactionPatterns": [
            {
              "id": "aws-key",
              "regex": "(?i)AKIA[0-9A-Z]{16}",
              "replacement": "[REDACTED_AWS_KEY]"
            },
            {
              "id": "private-key",
              "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
              "replacement": "[REDACTED_PRIVATE_KEY]"
            },
            {
              "id": "jwt",
              "regex": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
              "replacement": "[REDACTED_JWT]"
            },
            {
              "id": "generic-secret",
              "regex": "(?i)(api[_-]?key|secret|password|token)\\s*[:=]\\s*['\"]?[^'\"\\s]{8,}",
              "replacement": "$1=[REDACTED]"
            }
          ]
        }
      ],
      "approval": [
        {
          "id": "approve-read-payroll",
          "pattern": "**/payroll/**, **/hr/**",
          "reason": "HR data access requires sign-off",
          "timeoutSeconds": 300,
          "enabled": true
        }
      ]
    },
    "budget": {
      "maxSessionCostUsd": 2.0,
      "maxTurnCostUsd": 0.25,
      "maxSessionTokens": 200000,
      "maxTurnTokens": 50000,
      "onExceed": "block"
    },
    "time": {
      "maxTurnSeconds": 300,
      "maxSessionSeconds": 7200,
      "alertAfterSeconds": 60,
      "onExceed": "block"
    },
    "systemPrompt": {
      "mode": "append",
      "text": "You are governed by an AI Control Layer. Destructive actions and publishing steps require human approval and will be intercepted. Do not attempt to bypass tool restrictions; they are enforced outside your control."
    },
    "injection": {
      "enabled": true,
      "onDetect": "warn",
      "scanToolResults": true,
      "scanUserInput": false,
      "patterns": [
        {
          "id": "ignore-instructions",
          "regex": "(?i)ignore (all )?(previous|prior|above) (instructions|prompts|rules)"
        },
        {
          "id": "system-prompt-override",
          "regex": "(?i)(system prompt|instructions)\\s*[:=]\\s*['\"]"
        },
        {
          "id": "reveal-prompt",
          "regex": "(?i)(reveal|print|repeat) (your )?(system prompt|instructions)"
        },
        {
          "id": "tool-hijack",
          "regex": "(?i)(run|execute)\\s+the following (command|code)\\s*:"
        },
        {
          "id": "exfiltrate-data",
          "regex": "(?i)(send|post|upload) (this|the|all) (data|file|content|credentials|keys) to"
        }
      ]
    },
    "controlPlane": {
      "url": "ws://localhost:4747",
      "localFallback": "confirm"
    }
  },
  "agents": {
    "amir": {
      "budget": {
        "maxSessionCostUsd": 0.5,
        "maxTurnCostUsd": 0.1,
        "onExceed": "block"
      }
    }
  }
}
