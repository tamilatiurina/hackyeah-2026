{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "buildCommand": "bash build.sh"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "npx pnpm@12.8.1 install --frozen-lockfile",
      "buildCommand": "npx pnpm@12.8.1 run build",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "demo-agent": {
      "root": "apps/agents",
      "framework": "fastapi",
      "entrypoint": "app:app"
    },
    "landing": {
      "root": "apps/landing",
      "framework": "astro",
      "installCommand": "npx pnpm@12.8.1 install --frozen-lockfile",
      "buildCommand": "npx pnpm@12.8.1 run build"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/a/(.*)", "destination": { "service": "api" } },
    { "source": "/demo-agent/(.*)", "destination": { "service": "demo-agent" } },
    { "source": "/", "destination": { "service": "landing" } },
    { "source": "/_astro/(.*)", "destination": { "service": "landing" } },
    { "source": "/media/(.*)", "destination": { "service": "landing" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
