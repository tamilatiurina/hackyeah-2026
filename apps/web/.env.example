# Base URL of the FastAPI backend. The dev server proxies /api/* here (see vite.config.ts).
# Copy to .env.local to override.
API_URL=http://localhost:8000

# Supabase project for sign-in (same names as the API). SUPABASE_KEY is the publishable/anon key,
# never the service-role key: it is built into the browser bundle. `make supabase` writes local values.
SUPABASE_URL=
SUPABASE_KEY=
