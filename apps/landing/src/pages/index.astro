---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import Problem from '../components/Problem.astro'
import HowItWorks from '../components/HowItWorks.astro'
import Features from '../components/Features.astro'
import OneUrl from '../components/OneUrl.astro'
import Roles from '../components/Roles.astro'
import Tutorial from '../components/Tutorial.astro'
import Closing from '../components/Closing.astro'

// Every "Open the app" button goes to the production web app's playground, in every environment.
const appUrl = 'https://hackyeah-2026-theta.vercel.app/playground'
---

<Base
  title="Guardrail Hub: guardrails for every AI agent"
  description="Register an A2A agent by its URL, attach guardrails, policies and limits, and get a guarded URL that checks every message in and out."
>
  <Nav appUrl={appUrl} />
  <main>
    <Hero appUrl={appUrl} />
    <Problem />
    <HowItWorks />
    <Features />
    <OneUrl />
    <Roles />
    <Tutorial appUrl={appUrl} />
  </main>
  <Closing appUrl={appUrl} />
</Base>
