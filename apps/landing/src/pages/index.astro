---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import PromoVideo from '../components/PromoVideo.astro'
import Problem from '../components/Problem.astro'
import HowItWorks from '../components/HowItWorks.astro'
import Features from '../components/Features.astro'
import OneUrl from '../components/OneUrl.astro'
import Workspace from '../components/Workspace.astro'
import Tutorial from '../components/Tutorial.astro'
import Closing from '../components/Closing.astro'

// Every "Open the app" button goes to the production web app's agents list, in every environment.
const appUrl = '/agents'
---

<Base
  title="AgentsOnRails.dev: guardrails for every AI agent"
  description="Register an A2A agent by its URL, attach guardrails, policies and limits, and get a guarded URL that checks every message in and out."
>
  <Nav appUrl={appUrl} />
  <main>
    <Hero appUrl={appUrl} />
    <PromoVideo />
    <Problem />
    <HowItWorks />
    <Features />
    <OneUrl />
    <Workspace />
    <Tutorial appUrl={appUrl} />
  </main>
  <Closing appUrl={appUrl} />
</Base>
