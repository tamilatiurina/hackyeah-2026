---
import Logo from './Logo.astro'

interface Props {
  appUrl: string
}
const { appUrl } = Astro.props
---

<header class="sticky top-0 z-10 border-b border-line bg-canvas/90 backdrop-blur">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3 sm:px-6"
    aria-label="Main"
  >
    <a href="#top" class="flex items-center gap-2 font-bold text-ink no-underline">
      <Logo class="text-teal" />
      Guardrail Hub
    </a>
    <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
      <li><a class="hover:text-ink" href="#how">How it works</a></li>
      <li><a class="hover:text-ink" href="#features">Features</a></li>
      <li><a class="hover:text-ink" href="#a2a">A2A</a></li>
      <li><a class="hover:text-ink" href="#roles">Roles</a></li>
      <li><a class="hover:text-ink" href="#tutorial">Tutorial</a></li>
    </ul>
    <a class="btn btn-primary !px-4 !py-2 text-sm" href={appUrl}>Open the app</a>
  </nav>
</header>
