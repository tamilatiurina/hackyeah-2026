---
interface Props {
  appUrl: string
}
const { appUrl } = Astro.props

// A first-run walkthrough of the web app. Button names match the app's labels.
const wrapped = [
  {
    title: 'Register an agent',
    path: ['Agents', 'Register agent'],
    body: 'Paste an A2A agent URL. The hub reads its Agent Card and fills in the name and skills.',
  },
  {
    title: 'Guard it and deploy',
    path: ['Agent page', 'Deploy'],
    body: 'Attach guardrails in the order they should run, then deploy to get a guarded URL and a key.',
  },
  {
    title: 'Test it in the chat',
    path: ['Test chat', 'Send'],
    body: 'Send a message or pick a scenario. The trace shows which guardrails passed, redacted or blocked.',
  },
]

const integrated = [
  { page: 'Playground', body: 'Run a scenario: a banned command, a blocked file, a page with an injection.' },
  { page: 'Policies', body: 'Turn off the rule that stopped it, save, and run it again. It passes.' },
  { page: 'Incidents', body: 'Every block and redaction, with injection sources auto-banned.' },
]
---

<section id="tutorial" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <h2 class="text-3xl leading-tight font-semibold tracking-tight text-balance">
          Your first five minutes.
        </h2>
        <p class="mt-4 leading-relaxed text-muted">
          The tabs at the top of the sidebar switch between <strong class="font-semibold text-ink">Agent Wrapped</strong>
          for A2A agents and <strong class="font-semibold text-ink">Agent Integrated</strong> for pi coding agents.
        </p>
      </div>
      <a class="btn btn-secondary self-start md:self-auto" href={appUrl}>Follow along in the app</a>
    </div>

    <h3 class="mt-12 font-mono text-sm tracking-[0.06em] text-muted uppercase">Agent Wrapped</h3>
    <ol class="mt-4 grid gap-4 lg:grid-cols-3">
      {
        wrapped.map((step, i) => (
          <li class="flex flex-col rounded-xl bg-surface p-6 shadow-[inset_0_0_0_1px_var(--color-line)]">
            <span class="grid size-8 place-items-center rounded-full bg-teal-soft font-mono text-sm font-semibold text-teal-dark">
              {i + 1}
            </span>
            <h4 class="mt-4 text-lg font-semibold">{step.title}</h4>
            <p class="mt-2 flex-1 leading-relaxed text-muted">{step.body}</p>
            <p class="mt-5 flex flex-wrap items-center gap-2 text-sm" aria-label={`Go to ${step.path[0]}, then ${step.path[1]}`}>
              <span class="rounded-md px-2.5 py-1 shadow-[inset_0_0_0_1px_var(--color-line-strong)]">
                {step.path[0]}
              </span>
              <span aria-hidden="true" class="text-muted">→</span>
              <span class="rounded-md bg-teal px-2.5 py-1 font-semibold text-white">{step.path[1]}</span>
            </p>
          </li>
        ))
      }
    </ol>

    <h3 class="mt-12 font-mono text-sm tracking-[0.06em] text-muted uppercase">Agent Integrated</h3>
    <ol class="on-dark mt-4 grid overflow-hidden rounded-xl bg-console text-white lg:grid-cols-3">
      {
        integrated.map((step, i) => (
          <li class="border-console-line p-6 not-first:border-t lg:not-first:border-t-0 lg:not-first:border-l">
            <p class="flex items-center gap-3">
              <span class="grid size-8 place-items-center rounded-full bg-teal-bright font-mono text-sm font-semibold text-ink">
                {i + 1}
              </span>
              <span class="font-mono font-semibold text-teal-bright">{step.page}</span>
            </p>
            <p class="mt-3 leading-relaxed text-[#d6d8dc]">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
