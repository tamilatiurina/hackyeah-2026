---
interface Props {
  appUrl: string
}
const { appUrl } = Astro.props

// A first-run walkthrough of the web app. Button names match the app's labels.
const steps = [
  {
    title: 'Register an agent',
    path: ['Agents', 'Register agent'],
    body: 'Paste an A2A agent URL. The hub reads its Agent Card and opens the agent\'s setup.',
  },
  {
    title: 'Attach guardrails',
    path: ['Agent', 'Guardrails'],
    body: 'Pick checks from the library and put them in the order they should run.',
  },
  {
    title: 'Test the pipeline',
    path: ['Agent', 'Test'],
    body: 'Send a message or pick a scenario. The trace shows which guardrails passed, redacted or blocked.',
  },
  {
    title: 'Go live with a key',
    path: ['Agent', 'Go live'],
    body: 'Create a gateway key and point callers at the guarded URL.',
  },
]
---

<section id="tutorial" class="border-t border-line">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-xl">
        <h2 class="text-3xl leading-tight font-semibold tracking-tight text-balance">
          Your first five minutes.
        </h2>
        <p class="mt-4 leading-relaxed text-muted">
          Each agent gets its own workspace that walks you through setup, one step at a time.
        </p>
      </div>
      <a class="btn btn-secondary self-start md:self-auto" href={appUrl}>Follow along in the app</a>
    </div>

    <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li class="flex flex-col rounded-xl bg-surface p-6 shadow-[inset_0_0_0_1px_var(--color-line)]">
            <span class="grid size-8 place-items-center rounded-full bg-teal-soft font-mono text-sm font-semibold text-teal-dark">
              {i + 1}
            </span>
            <h4 class="mt-4 text-lg font-semibold">{step.title}</h4>
            <p class="mt-2 flex-1 leading-relaxed text-muted">{step.body}</p>
            <p class="mt-5 flex flex-wrap items-center gap-2 text-sm" aria-label={`Go to ${step.path[0]}, then ${step.path[1]}`}>
              <span class="rounded-md px-2.5 py-1 shadow-[inset_0_0_0_1px_var(--color-line-strong)]">
                {step.path[0]}
              </span>
              <span aria-hidden="true" class="text-muted">→</span>
              <span class="rounded-md bg-teal px-2.5 py-1 font-semibold text-white">{step.path[1]}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
