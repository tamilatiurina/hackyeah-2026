SUPABASE_URL=
SUPABASE_KEY=

# Required when any agent has MCP access. Generate once with:
# uv run --project apps/api python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MCP_CAPABILITY_KEY=
# Public API origin used in MCP proxy descriptors (required behind a reverse proxy/serverless URL).
PUBLIC_API_URL=

